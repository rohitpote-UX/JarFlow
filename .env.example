# ==========================================
# 🪣 JarFlow PWA - Environment Configuration
# ==========================================

# Application Identity & Branding
VITE_APP_NAME="JarFlow"
VITE_BUSINESS_NAME="PureFlow Waters (जलधारा)"
VITE_OWNER_NAME="Rohit Pote"
VITE_DEFAULT_PHONE="9822019988"
VITE_DEFAULT_UPI_ID="pureflow@upi"
VITE_DEFAULT_ADDRESS="Shop No. 4, Water Hub, Main Road, Pune"

# Business Parameters
VITE_DEFAULT_JAR_RATE=35
VITE_DEFAULT_LANGUAGE="mr"
VITE_TOTAL_GODOWN_JARS=500
VITE_LOW_STOCK_THRESHOLD=40

# API Base URL (Can point to your Laravel API or proxy)
VITE_API_BASE_URL="/api"

# PWA Feature Flags
VITE_ENABLE_PWA="true"
VITE_ENABLE_PUSH_NOTIFICATIONS="true"
